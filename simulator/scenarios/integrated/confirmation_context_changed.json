{
  "name": "confirmation_context_changed",
  "runtimeFlow": true,
  "config": {
    "initialRobotStatus": {
      "emergencyStopActive": true
    }
  },
  "steps": [
    {
      "name": "request reset confirmation",
      "assistant": {
        "commands": ["reset_emergency_stop"]
      },
      "expect": {
        "confirmationState": "requested"
      }
    },
    {
      "name": "emergency state changes before submit",
      "robotStatus": {
        "emergencyStopActive": false
      },
      "assistant": {
        "commands": ["reset_emergency_stop"]
      },
      "submitConfirmation": "last",
      "expect": {
        "command": null,
        "confirmationState": "context_changed"
      }
    }
  ]
}
