{
  "name": "emergency_reset_expired_confirmation",
  "runtimeFlow": true,
  "config": {
    "confirmationTtlSeconds": -1,
    "initialRobotStatus": {
      "emergencyStopActive": true
    }
  },
  "steps": [
    {
      "name": "request reset confirmation",
      "assistant": {
        "commands": ["reset_emergency_stop"]
      },
      "expect": {
        "confirmationState": "requested"
      }
    },
    {
      "name": "submit expired id",
      "assistant": {
        "commands": ["reset_emergency_stop"]
      },
      "submitConfirmation": "last",
      "expect": {
        "command": null,
        "confirmationState": "expired",
        "sentCommand": false
      }
    }
  ]
}
